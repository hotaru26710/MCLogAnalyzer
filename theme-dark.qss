/* 清爽现代风 — 深色主题（直接对整个 MainWindow 加载） */
QMainWindow, QWidget {
    background-color: #181c23;
    color: #d6deea;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

QTabWidget::pane { border: none; }
QWidget#centralwidget { background-color: #181c23; }

/* ==== 顶部文件区 ==== */
QLabel#fileLabel {
    font-size: 15px;
    font-weight: 600;
    color: #e6edf8;
}
QLabel#fileHint { color: #7c879c; padding-top: 2px; }

/* ==== 按钮 ==== */
QPushButton {
    background-color: #262c36;
    color: #e0e7f2;
    border: 1px solid #39414f;
    border-radius: 10px;
    padding: 8px 20px;
    font-weight: 600;
}
QPushButton:hover { background-color: #303847; border-color: #4a5669; }
QPushButton:pressed { background-color: #20252e; }
QPushButton:disabled {
    background-color: #2a2f38; color: #5a6272;
    border-color: #333a46;
}
QPushButton#themeToggle { padding: 6px 16px; border-radius: 18px; }
QPushButton#analyzeBtn {
    background-color: #4c8bf5;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 9px 24px;
}
QPushButton#analyzeBtn:hover { background-color: #5e9bf8; }
QPushButton#analyzeBtn:pressed { background-color: #3a7ae0; }
QPushButton#analyzeBtn:disabled { background-color: #2c4d7a; color: #9db8de; }

/* ==== 预览文本框 ==== */
QTextEdit#logPreview {
    background-color: #1e232c;
    color: #c9d4e5;
    border: 1px solid #39414f;
    border-radius: 10px;
    padding: 6px;
    selection-background-color: #4c8bf5;
    selection-color: #ffffff;
}

/* ==== 页签 ==== */
QTabBar::tab {
    padding: 9px 26px;
    background: transparent;
    font-weight: 600;
    color: #8a94a8;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QTabBar::tab:selected {
    background-color: #4c8bf5;
    color: #ffffff;
}
QTabBar::tab:hover:!selected { color: #7fb0ff; }

/* ==== 树形视图 ==== */
QTreeWidget {
    border: none;
    background-color: #1e232c;
    color: #c9d4e5;
    outline: none;
}
QTreeWidget#resultTree, QTreeWidget#detailsTree {
    border: 1px solid #2d3542;
    border-top: none;
}
QTreeWidget::item { padding: 4px 2px; border-radius: 4px; }
QTreeWidget::item:selected {
    background-color: rgba(76, 139, 245, 0.25);
    color: #9fc2ff;
}
QTreeWidget::item:hover:!selected { background-color: rgba(255,255,255,0.03); }
QHeaderView::section {
    background-color: #232933;
    color: #aab6c8;
    border: none;
    border-bottom: 1px solid #313946;
    padding: 7px 8px;
    font-weight: 600;
}

/* ==== 进度条 ==== */
QProgressBar {
    border: none;
    background-color: #262c36;
    border-radius: 7px;
    text-align: center;
    font-size: 11px;
    color: #7fb0ff;
    font-weight: 600;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #3a6fd9, stop:1 #6aa0ff);
    border-radius: 7px;
}

/* ==== 滚动条 ==== */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical {
    background: #3b4351; border-radius: 5px; min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #4a5568; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal {
    background: #3b4351; border-radius: 5px; min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: #4a5568; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ==== 状态栏 ==== */
QStatusBar { background-color: #20252e; color: #7c879c; border-top: 1px solid #2d3542; }

/* ==== 弹窗 ==== */
QMessageBox { background-color: #262c36; }
